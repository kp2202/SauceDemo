BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
STANDARD_PASSWORD=secret_sauce
HEADLESS=true

# Build type: development, staging, production
BUILD_TYPE=development

# LLM Configuration (Phase 1: AI-Driven Test Generation)
# Support for OpenAI (GPT-4) or Anthropic (Claude)
LLM_PROVIDER=openai
# For OpenAI: sk-...
# For Anthropic: sk-ant-...
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4-turbo-preview

# Optional: Model parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Phase 2: CI Optimization - Database
DATABASE_URL=sqlite:./test-metrics.db

# Phase 3: Vision API (for self-healing tests)
VISION_API_ENABLED=false

# Phase 4: Feature Flags
FEATURE_FLAG_PROVIDER=local
FEATURE_FLAG_URL=https://your-feature-flag-service.com

# Phase 5: Slack Notifications (optional)
SLACK_WEBHOOK_URL=
